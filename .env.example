# --- Database ---
POSTGRES_USER=customerpulse
POSTGRES_PASSWORD=changeme
POSTGRES_DB=customerpulse
DATABASE_URL=postgresql://customerpulse:changeme@localhost:5432/customerpulse

# --- Auth ---
JWT_SECRET=changeme
JWT_EXPIRY_MINUTES=60

# --- AI Agent (Anthropic API) ---
ANTHROPIC_API_KEY=
AGENT_MODEL=claude-sonnet-5
AGENT_MAX_TOOL_CALLS=8
AGENT_MAX_TOKENS=4000

# --- MLOps (optional, enable as phases land) ---
MLFLOW_TRACKING_URI=
PREFECT_API_URL=

# --- Dataset sampling (dev only, see docs/master_prompt.md Addendum E) ---
DEV_SAMPLE_FRACTION=0.1

# --- Hyperparameter tuning (see docs/master_prompt.md Addendum J) ---
OPTUNA_N_TRIALS=50
OPTUNA_SEED=42
OPTUNA_STORAGE=

# --- Churn model decision threshold (see Addendum F) ---
# Set from a stated cost ratio (cost of missed churner : cost of unneeded
# intervention), not left at the default 0.5.
CHURN_DECISION_THRESHOLD=0.5
CHURN_COST_RATIO=5:1
